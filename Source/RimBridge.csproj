<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <HarmonyDll Condition=" '$(HarmonyDll)' == '' ">$(HOME)/Library/Application Support/Steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyDll>
    <GameDir Condition=" '$(GameDir)' == '' ">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app/Contents/MacOS</GameDir>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RimBridge</RootNamespace>
    <AssemblyName>RimBridge</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../$(GameVersion)/Assemblies/</OutputPath>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591;CS8632</NoWarn>
    <DebugType>portable</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 1.7 (Waylith, .NET 10 CLR): compile against the installed game assemblies; Harmony comes from the Workshop Harmony mod (load it first); 0Harmony.dll is referenced, not copied. -->
  <PropertyGroup Condition=" '$(GameVersion)' == '1.7' ">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup Condition=" '$(GameVersion)' != '1.7' ">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup Condition=" '$(GameVersion)' == '1.7' ">
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.1" PrivateAssets="All" Condition=" '$(GameVersion)' != '1.7' " />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="All" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyNewtonsoftJson" AfterTargets="Build">
    <Copy SourceFiles="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition=" '$(GameVersion)' != '1.7' " />
    <Copy SourceFiles="$(PkgNewtonsoft_Json)/lib/netstandard2.0/Newtonsoft.Json.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition=" '$(GameVersion)' == '1.7' " />
  </Target>

</Project>
